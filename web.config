<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows / iisnode) configuration.
  For Linux App Service this file is ignored; the startup command
  `npm start` (defined in package.json) is used instead.
-->
<configuration>
  <system.webServer>
    <webSocket enabled="false" />
    <handlers>
      <add name="iisnode" path=".output/server/index.mjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="StaticContent" stopProcessing="true">
          <match url="^(.output/public/.*)" />
          <action type="Rewrite" url="{R:1}" />
        </rule>
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url=".output/server/index.mjs" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>